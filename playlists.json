{
  "tv360-12.m3u": {
    "base": "base/tv360-12.m3u",
    "channels": [
      {
        "match": "^TV360\\+12$",
        "rename": "TV360+12 (dự phòng)",
        "after": "TV360+12"
      },
      {
        "match": "^VTV(?!\\s*-?\\s*(cab|c[aáàảãạ]p))",
        "all": true,
        "group": "VTV"
      },
      {
        "match": "^(VTV\\s*-?\\s*(cab|c[aáàảãạ]p)|ON\\s)",
        "match_group": "^VTV\\s*-?\\s*cab",
        "all": true,
        "group": "VTV Cáp"
      },
      {
        "match": "^SCTV",
        "all": true,
        "group": "SCTV"
      }
    ]
  }
}
